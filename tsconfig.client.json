{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true
  },
  "include": [
    "packages/shared/*/src/**/*.ts",
    "packages/client/*/src/**/*.ts",
    "packages/client/*/tests/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx"
  ],
  "exclude": ["**/node_modules/**", "**/lib/**", "**/dist/**"]
}
